/* Application resources. The icon is embedded so Explorer, the taskbar and
   Alt-Tab show the app's own icon (a runtime WM_SETICON only affects the
   window frame). */
#include <windows.h>

/* Numerically lowest ID => this is the icon Explorer uses for the .exe file. */
#define IDI_APPICON 1

IDI_APPICON ICON "app.ico"

