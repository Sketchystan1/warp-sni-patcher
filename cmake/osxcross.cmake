set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING "Minimum macOS version")
set(OSXCROSS_BIN "$ENV{OSXCROSS_BIN}" CACHE PATH "OSXCross bin directory")
set(OSXCROSS_ARCH x86_64 CACHE STRING "macOS target architecture")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OSXCROSS_BIN OSXCROSS_ARCH)

if(OSXCROSS_ARCH STREQUAL "arm64")
    set(wrapper oa64)
else()
    set(wrapper o64)
endif()
find_program(OSXCROSS_CXX NAMES ${wrapper}-clang++ HINTS "${OSXCROSS_BIN}" REQUIRED NO_DEFAULT_PATH)
execute_process(COMMAND "${OSXCROSS_CXX}" -dumpmachine
    OUTPUT_VARIABLE triple OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(CMAKE_SYSTEM_PROCESSOR "${OSXCROSS_ARCH}")
set(CMAKE_OSX_ARCHITECTURES "${OSXCROSS_ARCH}" CACHE STRING "Target architecture")
set(CMAKE_C_COMPILER "${OSXCROSS_BIN}/${wrapper}-clang")
set(CMAKE_CXX_COMPILER "${OSXCROSS_CXX}")
set(CMAKE_OBJCXX_COMPILER "${OSXCROSS_CXX}")
foreach(tool ar ranlib strip install_name_tool)
    string(TOUPPER "${tool}" name)
    set(CMAKE_${name} "${OSXCROSS_BIN}/${triple}-${tool}")
endforeach()
foreach(language C CXX OBJCXX)
    set(CMAKE_${language}_COMPILER_AR "${CMAKE_AR}")
    set(CMAKE_${language}_COMPILER_RANLIB "${CMAKE_RANLIB}")
endforeach()
# OSXCross supplies its SDK automatically; retain host paths for build tools only.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
